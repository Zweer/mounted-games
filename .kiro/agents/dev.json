{
  "name": "dev",
  "description": "Development agent — implements the mounted-games Next.js portal (app, DB schema, scrapers, poller) from the specs and the docs/sources scraping contract",
  "prompt": "file://../prompts/dev.md",
  "resources": [
    "file://AGENTS.md",
    "file://.kiro/steering/**/*.md",
    "file://.kiro/docs/**/*.md",
    "file://.kiro/specs/**/*.md",
    "file://docs/sources/**/*.md"
  ],
  "tools": [
    "read",
    "write",
    "shell",
    "grep",
    "glob",
    "web_search",
    "web_fetch",
    "introspect",
    "thinking",
    "code"
  ],
  "toolsSettings": {
    "write": {
      "allowedPaths": [
        ".kiro/**",
        "app/**",
        "components/**",
        "db/**",
        "lib/**",
        "hooks/**",
        "docs/**",
        "auth.ts",
        "middleware.ts",
        "next.config.ts",
        "drizzle.config.ts",
        "biome.json",
        "vitest.config.ts",
        "package.json",
        "package-lock.json",
        "tsconfig.json",
        "postcss.config.mjs",
        "components.json",
        "vercel.json",
        ".env.example",
        ".gitignore",
        "public/**",
        "README.md"
      ]
    },
    "shell": {
      "autoAllowReadonly": true,
      "deniedCommands": [".*git commit.*", ".*git push.*", ".*git tag .*", ".*npm publish.*"]
    }
  }
}
