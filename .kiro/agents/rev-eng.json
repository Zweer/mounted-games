{
  "name": "rev-eng",
  "description": "Reverse engineering agent — discovers how mg-scoreboard.de and pmglivescore.altervista.org expose their data, via Playwright network interception and DOM inspection",
  "prompt": "file://../prompts/rev-eng.md",
  "resources": ["file://docs/sources/**/*.md", "file://AGENTS.md", "file://.kiro/docs/functional-spec.md"],
  "tools": [
    "read",
    "write",
    "shell",
    "grep",
    "glob",
    "web_search",
    "web_fetch",
    "introspect",
    "thinking",
    "@playwright"
  ],
  "allowedTools": ["read", "grep", "glob", "web_fetch", "@playwright"],
  "toolsSettings": {
    "write": {
      "allowedPaths": ["docs/sources/**"]
    },
    "shell": {
      "autoAllowReadonly": true,
      "deniedCommands": [".*git commit.*", ".*git push.*", ".*git tag .*", ".*npm publish.*"]
    }
  },
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "@playwright/mcp@latest",
        "--browser=chromium",
        "--headless",
        "--caps=core,network,storage",
        "--console-level=info"
      ]
    }
  }
}
