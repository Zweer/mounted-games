# Local Node/dev + Vitest environment (`next dev`, `npm test`, tsx scripts).
#
# The app runs on Cloudflare Workers + D1 (SQLite). Under Node there is no D1
# binding, so the dev/test path uses better-sqlite3 (db/index.ts getDb). For the
# Workers runtime secrets/bindings see `.dev.vars.example` (loaded by wrangler)
# and `wrangler.jsonc` (D1 `DB` + KV `POLLER_KV` bindings).

# Optional: path for the local better-sqlite3 database. Defaults to ":memory:"
# (used by the Vitest harness). Set a file path to persist a local dev DB.
# DATABASE_PATH="./local.db"

# Better Auth. Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-random-32-byte-secret"
# Public base URL of the app (no trailing slash).
BETTER_AUTH_URL="http://localhost:3000"

# Shared bearer token protecting the manual ingestion routes (/api/poll,
# /api/seed, /api/admin/reset). Added in the 01-ingestion spec. The Cron Trigger
# does not use it — it guards only the manually-invoked HTTP routes.
CRON_SECRET="replace-with-a-random-token"

# Base URLs of the scraped source portals (01-ingestion).
MG_SCOREBOARD_BASE_URL="https://mg-scoreboard.de"
PMG_LIVESCORE_BASE_URL="https://pmglivescore.altervista.org"
