# Neon PostgreSQL connection string (pooled endpoint from the Neon dashboard).
DATABASE_URL="postgresql://user:password@host.neon.tech/mounted_games?sslmode=require"

# Better Auth. Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-random-32-byte-secret"
# Public base URL of the app (no trailing slash).
BETTER_AUTH_URL="http://localhost:3000"

# Shared bearer token protecting the ingestion poll route (/api/poll),
# sent by the external scheduler (cron-job.org). Added in the 01-ingestion spec.
CRON_SECRET="replace-with-a-random-token"

# Base URLs of the scraped source portals (01-ingestion).
MG_SCOREBOARD_BASE_URL="https://mg-scoreboard.de"
PMG_LIVESCORE_BASE_URL="https://pmglivescore.altervista.org"
